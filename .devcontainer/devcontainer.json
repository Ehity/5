{
  "name": "Сбер.Сканер Подписок",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && cd frontend && npm ci && npm run build",
  "postStartCommand": "cd backend && (nohup python -m uvicorn main:app --host 0.0.0.0 --port 8000 > /tmp/uvicorn.log 2>&1 &)",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Сканер Подписок",
      "onAutoForward": "openBrowser"
    }
  }
}
